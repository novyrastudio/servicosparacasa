  /* ---------- dialog manager (native <dialog>: focus trap + Escape; we add scroll lock, focus restore, backdrop click) ---------- */
  const returnFocus = new WeakMap();
  function openDlg(d, trigger) {
    if (!d || d.open) return;
    returnFocus.set(d, trigger || document.activeElement);
    document.body.classList.add('is-locked');
    d.showModal();
  }
  function wireDialog(d) {
    if (!d) return;
    d.addEventListener('close', () => {
      if (!$$('dialog[open]').length) document.body.classList.remove('is-locked');
      const t = returnFocus.get(d); if (t && document.contains(t) && t.focus) t.focus();
    });
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    $$('[data-close]', d).forEach((b) => b.addEventListener('click', () => d.close()));
  }

