<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Exemplo Serviços Residenciais | Serviços para sua casa</title>
<meta name="description" content="Serviços residenciais com comunicação clara e acabamento cuidadoso. Solicite um orçamento online.">
<meta name="theme-color" content="#171C1B">
<meta property="og:type" content="website">
<meta property="og:title" content="Exemplo Serviços Residenciais | Serviços para sua casa">
<meta property="og:description" content="Serviços residenciais com comunicação clara e acabamento cuidadoso.">
<meta name="twitter:card" content="summary_large_image">

<style>
/* HOME SERVICES ELITE — Novyra Studio. Colors are CSS variables set from config.theme. */
:root{
  --charcoal:#171C1B;--forest:#355847;--ivory:#F4F1E9;--sage:#B7C5B8;--white:#fff;--muted:#5B645E;--border:#D9DED8;
  --font-head:"Newsreader",Georgia,serif;--font-body:"Hanken Grotesk",system-ui,sans-serif;
  --pad:clamp(20px,5vw,72px);--max:1320px;--header-h:72px;--banner-h:0px;
  --ease:cubic-bezier(.2,.6,.2,1);
}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 12px)}
body{margin:0;font-family:var(--font-body);font-size:1.0625rem;line-height:1.6;color:var(--charcoal);background:var(--ivory);overflow-x:hidden}
body.is-locked{overflow:hidden}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
h1,h2,h3,h4{font-family:var(--font-head);font-weight:400;line-height:1.08;margin:0;letter-spacing:-.01em}
p{margin:0}
ul{margin:0;padding:0;list-style:none}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--forest);outline-offset:3px;border-radius:2px}
.on-dark :focus-visible,.dark :focus-visible{outline-color:var(--sage)}
.skip-link{position:absolute;left:12px;top:-60px;z-index:200;background:var(--charcoal);color:#fff;padding:10px 16px;text-decoration:none}
.skip-link:focus{top:12px}
.container{width:100%;max-width:var(--max);margin-inline:auto;padding-inline:var(--pad)}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* Sections & rhythm */
.section{padding-block:clamp(72px,11vw,150px)}
.dark{background:var(--charcoal);color:var(--ivory)}
.forest{background:var(--forest);color:var(--ivory)}
.paper{background:var(--white)}
.muted{color:var(--muted)}
.dark .muted,.forest .muted{color:var(--sage)}
.h2{font-size:clamp(2.1rem,5vw,3.9rem)}
.h3{font-size:clamp(1.45rem,2.4vw,2rem)}
.eyebrow{font-size:.9rem;font-weight:500;color:var(--forest);letter-spacing:.02em;margin-bottom:1.1rem}
.dark .eyebrow,.forest .eyebrow{color:var(--sage)}
.sample-note{display:inline-block;font-size:.8rem;border:1px solid currentColor;padding:2px 10px;border-radius:99px;opacity:.85}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:48px;padding:.8rem 1.6rem;border:1px solid transparent;font-weight:500;font-size:1rem;text-decoration:none;cursor:pointer;border-radius:2px;transition:background .25s var(--ease),color .25s var(--ease),border-color .25s var(--ease),transform .25s var(--ease)}
.btn-primary{background:var(--forest);color:#fff}
.btn-primary:hover{background:#2a4639}
.dark .btn-primary,.forest .btn-primary{background:var(--ivory);color:var(--charcoal)}
.dark .btn-primary:hover,.forest .btn-primary:hover{background:var(--sage)}
.btn-ghost{border-color:currentColor;background:transparent}
.btn-ghost:hover{background:var(--charcoal);color:var(--ivory);border-color:var(--charcoal)}
.dark .btn-ghost:hover,.forest .btn-ghost:hover{background:var(--ivory);color:var(--charcoal);border-color:var(--ivory)}
.link{background:none;border:0;padding:0;font-weight:500;cursor:pointer;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px;min-height:44px;display:inline-flex;align-items:center}
.link:hover{text-decoration-thickness:2px}

/* Utility bar */
.utility{background:var(--charcoal);color:var(--sage);font-size:.86rem}
.utility .container{display:flex;flex-wrap:wrap;gap:.25rem 2rem;justify-content:space-between;padding-block:8px}
.utility a{text-decoration:none}.utility a:hover{text-decoration:underline}
.utility .u-list{display:flex;flex-wrap:wrap;gap:.25rem 2rem}
@media(max-width:640px){.utility .u-hours{display:none}}

/* Header */
.site-header{position:sticky;top:0;z-index:50;background:rgba(244,241,233,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
.site-header .container{display:flex;align-items:center;justify-content:space-between;height:var(--header-h);gap:1rem}
.logo{display:inline-flex;align-items:center;gap:.7rem;text-decoration:none;font-family:var(--font-head);font-size:1.4rem;line-height:1.1;min-height:44px}
.logo-mark{display:grid;place-items:center;width:36px;height:36px;background:var(--charcoal);color:var(--sage);font-size:1.1rem;flex:none}
.logo img{max-height:40px;width:auto}
.nav-list{display:flex;align-items:center;gap:clamp(1rem,2vw,2.2rem)}
.nav-list a.nav-link{text-decoration:none;font-size:.97rem;padding:.5rem 0;position:relative;display:inline-block}
.nav-link::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .3s var(--ease)}
.nav-link:hover::after{transform:scaleX(1)}
.nav-cta{padding:.6rem 1.2rem;min-height:44px}
.menu-btn{display:none;background:none;border:1px solid var(--charcoal);width:48px;height:48px;border-radius:2px;cursor:pointer;position:relative}
.menu-btn span{position:absolute;left:13px;right:13px;height:1.5px;background:var(--charcoal);transition:transform .3s var(--ease),opacity .2s}
.menu-btn span:nth-child(1){top:18px}.menu-btn span:nth-child(2){top:23px}.menu-btn span:nth-child(3){top:28px}
.menu-btn[aria-expanded=true] span:nth-child(1){transform:translateY(5px) rotate(45deg)}
.menu-btn[aria-expanded=true] span:nth-child(2){opacity:0}
.menu-btn[aria-expanded=true] span:nth-child(3){transform:translateY(-5px) rotate(-45deg)}
@media(max-width:959px){
  .menu-btn{display:block}
  .site-nav{position:absolute;left:0;right:0;top:100%;background:var(--ivory);border-bottom:1px solid var(--border);padding:8px var(--pad) 28px;visibility:hidden;opacity:0;transform:translateY(-8px);transition:opacity .25s var(--ease),transform .25s var(--ease),visibility .25s;max-height:calc(100vh - var(--header-h));max-height:calc(100dvh - var(--header-h));overflow:auto}
  .site-nav.open{visibility:visible;opacity:1;transform:none}
  .nav-list{flex-direction:column;align-items:stretch;gap:0}
  .nav-list a.nav-link{font-family:var(--font-head);font-size:1.8rem;padding:.8rem 0;border-bottom:1px solid var(--border);display:block}
  .nav-link::after{display:none}
  .nav-cta{margin-top:1.4rem;width:100%}
}

/* Hero */
.hero{padding-block:clamp(32px,6vw,80px) clamp(56px,8vw,110px);overflow:hidden}
.hero-grid{display:grid;gap:clamp(28px,5vw,64px);align-items:end}
.hero h1{font-size:clamp(2.9rem,9vw,4.2rem);line-height:.98;letter-spacing:-.025em;text-wrap:balance}
.hero-copy .lede{margin-top:1.6rem;font-size:clamp(1.05rem,1.6vw,1.25rem);color:var(--muted);max-width:34em}
.hero-actions{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2.2rem}
.hero-media{position:relative;margin:0}
.hero-media img{width:100%;aspect-ratio:4/5;object-fit:cover}
.hero-label{position:absolute;left:0;bottom:0;background:var(--ivory);padding:14px 22px 14px 0;font-size:.92rem;display:flex;flex-direction:column}
.hero-label strong{font-family:var(--font-head);font-weight:400;font-size:1.25rem}
@media(min-width:960px){
  .hero-grid{grid-template-columns:repeat(12,1fr);align-items:stretch}
  .hero h1{font-size:clamp(4rem,6vw,5.6rem)}
  .hero-copy{grid-column:1/6;display:flex;flex-direction:column;justify-content:space-between;padding-block:1rem 0}
  
  .hero-media{grid-column:6/13;margin-right:calc(var(--pad) * -1)}
  .hero-media img{aspect-ratio:auto;height:100%;min-height:600px;max-height:78vh}
  .hero-note{margin-top:3rem}
}
.hero-note{font-size:.92rem;color:var(--muted);border-top:1px solid var(--border);padding-top:1rem;margin-top:2.4rem;max-width:22rem}

/* Services */
.split-head{display:grid;gap:1.2rem 4rem;margin-bottom:clamp(40px,6vw,80px)}
@media(min-width:900px){.split-head{grid-template-columns:7fr 5fr;align-items:end}}
.svc-features{display:grid;gap:clamp(40px,6vw,72px)}
@media(min-width:900px){
  .svc-features.two{grid-template-columns:7fr 5fr;align-items:start}
  .svc-features.two .svc-feature:nth-child(2){margin-top:clamp(60px,9vw,140px)}
}
.svc-feature img{width:100%;object-fit:cover;aspect-ratio:4/3;transition:transform .8s var(--ease)}
.svc-feature:nth-child(2) img{aspect-ratio:4/5}
.svc-feature .frame{overflow:hidden;margin-bottom:1.4rem}
.svc-feature:hover img{transform:scale(1.025)}
.svc-feature p{color:var(--muted);max-width:30em;margin:.7rem 0 1rem}
.svc-feature.no-img{border-top:1px solid var(--border);padding-top:1.4rem}
.svc-rows{margin-top:clamp(56px,8vw,110px);border-top:1px solid var(--charcoal)}
.svc-row{display:grid;gap:.4rem 2rem;padding:1.5rem 0;border-bottom:1px solid var(--border);align-items:center}
.svc-row p{color:var(--muted)}
@media(min-width:800px){.svc-row{grid-template-columns:4fr 6fr auto}}

/* Statement */
.statement{text-align:left}
.statement h2{font-size:clamp(2.6rem,8vw,6.4rem);line-height:1;max-width:11em;letter-spacing:-.025em;text-wrap:balance}
.statement p{margin-top:2rem;max-width:36em;color:var(--sage);font-size:1.15rem;margin-left:0}
@media(min-width:900px){.statement p{margin-left:calc(50% + 2rem);margin-top:3rem}}

/* Approach */
.steps{display:grid;border-top:1px solid var(--charcoal);margin-top:clamp(40px,6vw,72px)}
.step{padding:1.8rem 0 2.2rem;border-bottom:1px solid var(--border);display:grid;gap:.6rem}
.step-n{font-family:var(--font-head);font-size:1.1rem;color:var(--forest)}
.step p{color:var(--muted);max-width:28em}
@media(min-width:900px){
  .steps{grid-template-columns:repeat(var(--cols,3),1fr)}
  .step{border-bottom:0;padding:2rem 2rem 0 0}
  .step+.step{border-left:1px solid var(--border);padding-left:2rem}
  .step:nth-child(even){padding-top:5rem}
}
.cta-band{border-top:1px solid var(--border)}
.cta-band .container{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1.5rem;padding-block:clamp(36px,5vw,64px)}
.cta-band h2{font-size:clamp(1.7rem,3.4vw,2.6rem)}

/* Featured project */
.feature-grid{display:grid;gap:clamp(28px,5vw,64px);align-items:end}
@media(min-width:960px){.feature-grid{grid-template-columns:8fr 4fr}}
.feature-grid img{width:100%;aspect-ratio:16/10;object-fit:cover}
.feature-meta{display:flex;flex-direction:column;gap:1.2rem;align-items:flex-start}
.feature-meta .tag{font-size:.92rem;color:var(--sage)}

/* Gallery */
.gallery{columns:1;column-gap:clamp(12px,2vw,24px);margin-top:clamp(32px,5vw,56px)}
@media(min-width:600px){.gallery{columns:2}}
@media(min-width:1000px){.gallery{columns:3}}
.g-item{break-inside:avoid;margin:0 0 clamp(12px,2vw,24px);position:relative}
.g-item button{display:block;width:100%;padding:0;border:0;background:none;cursor:zoom-in;overflow:hidden}
.g-item img{width:100%;height:auto;transition:transform .7s var(--ease)}
.g-item button:hover img{transform:scale(1.03)}
.g-item.static button{cursor:default}
.g-item figcaption{font-size:.9rem;color:var(--muted);padding-top:.5rem}

/* Why */
.why-grid{display:grid;gap:0 4rem}
@media(min-width:900px){.why-grid{grid-template-columns:4fr 8fr}.why-title{position:sticky;top:calc(var(--header-h) + 32px);align-self:start}}
.why-list li{display:grid;grid-template-columns:auto 1fr;gap:.2rem 1.2rem;padding:1.4rem 0;border-bottom:1px solid var(--border)}
.why-list li:first-child{border-top:1px solid var(--charcoal)}
.why-list svg{width:22px;height:22px;margin-top:.35rem;color:var(--forest);grid-row:span 2}
.why-list h3{font-size:1.5rem}
.why-list p{color:var(--muted)}

/* About */
.about-grid{display:grid;gap:clamp(32px,5vw,72px);align-items:center}
@media(min-width:960px){.about-grid{grid-template-columns:5fr 6fr}}
.about-grid img{width:100%;aspect-ratio:4/3;object-fit:cover}
.about-copy p+p{margin-top:1rem}
.about-copy .h2{margin-bottom:1.6rem}
.philosophy{font-family:var(--font-head);font-size:clamp(1.4rem,2.4vw,1.9rem);line-height:1.25;border-left:2px solid var(--forest);padding-left:1.2rem;margin:2rem 0}
.team-list{display:flex;flex-wrap:wrap;gap:1rem 2.5rem;margin:1.5rem 0}
.team-list span{display:block;color:var(--muted);font-size:.92rem}

/* Areas */
.areas-grid{display:grid;gap:2.5rem 4rem}
@media(min-width:900px){.areas-grid{grid-template-columns:6fr 6fr;align-items:end}}
.main-city{font-family:var(--font-head);font-size:clamp(3rem,10vw,7rem);line-height:1;letter-spacing:-.02em;margin-top:.6rem}
.area-list li{padding:.8rem 0;border-bottom:1px solid rgba(183,197,184,.3);font-family:var(--font-head);font-size:1.4rem}
.area-list li:first-child{border-top:1px solid rgba(183,197,184,.3)}

/* Testimonials */
.quotes{display:grid;gap:3rem;margin-top:3rem}
@media(min-width:900px){.quotes{grid-template-columns:repeat(var(--cols,2),1fr)}}
blockquote{margin:0;font-family:var(--font-head);font-size:clamp(1.3rem,2.2vw,1.8rem);line-height:1.3}
.quotes figcaption{margin-top:1rem;font-size:.92rem;color:var(--muted)}

/* FAQ */
.faq-grid{display:grid;gap:2rem 4rem}
@media(min-width:900px){.faq-grid{grid-template-columns:4fr 8fr}}
.acc-item{border-bottom:1px solid var(--border)}
.acc-item:first-child{border-top:1px solid var(--charcoal)}
.acc-btn{width:100%;display:flex;justify-content:space-between;align-items:center;gap:1rem;text-align:left;background:none;border:0;padding:1.3rem 0;cursor:pointer;font-family:var(--font-head);font-size:clamp(1.2rem,2vw,1.55rem);min-height:56px}
.acc-btn .plus{flex:none;width:18px;height:18px;position:relative}
.acc-btn .plus::before,.acc-btn .plus::after{content:"";position:absolute;background:currentColor;left:0;right:0;top:8px;height:1.5px;transition:transform .3s var(--ease)}
.acc-btn .plus::after{transform:rotate(90deg)}
.acc-btn[aria-expanded=true] .plus::after{transform:rotate(0)}
.acc-panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s var(--ease)}
.acc-panel>div{overflow:hidden}
.acc-panel.open{grid-template-rows:1fr}
.acc-panel p{padding:0 2rem 1.5rem 0;color:var(--muted);max-width:40em}

/* Contact */
.contact-grid{display:grid;gap:2.5rem 4rem}
@media(min-width:900px){.contact-grid{grid-template-columns:5fr 7fr}}
.contact-list{display:grid;gap:0}
.contact-row{display:grid;gap:.2rem 2rem;padding:1.1rem 0;border-bottom:1px solid rgba(183,197,184,.3)}
.contact-row:first-child{border-top:1px solid rgba(183,197,184,.3)}
.contact-row dt{color:var(--sage);font-size:.9rem}
.contact-row dd{margin:0;font-family:var(--font-head);font-size:1.4rem;overflow-wrap:anywhere}
.contact-row dd small{display:block;font-family:var(--font-body);font-size:.95rem;color:var(--sage)}
@media(min-width:640px){.contact-row{grid-template-columns:10rem 1fr}}
.contact-row a{text-decoration-thickness:1px;text-underline-offset:4px}
.contact-actions{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}

/* Footer */
.site-footer{background:#0f1312;color:var(--sage);padding-block:clamp(48px,7vw,88px) 84px;font-size:.97rem}
.footer-grid{display:grid;gap:2.5rem}
@media(min-width:800px){.footer-grid{grid-template-columns:5fr 2fr 2fr 3fr}}
.site-footer h2{font-family:var(--font-body);font-size:.95rem;font-weight:600;color:var(--ivory);margin-bottom:.8rem;letter-spacing:0}
.site-footer li{margin:.15rem 0}
.site-footer a,.site-footer .link{text-decoration:none;display:inline-flex;align-items:center;min-height:36px;color:inherit}
.site-footer a:hover,.site-footer .link:hover{color:#fff;text-decoration:underline}
.site-footer .link{font-weight:400;text-decoration:none}
.site-footer .logo{color:var(--ivory)}
.site-footer .btn{margin-top:1.4rem}
.footer-bottom{margin-top:3rem;padding-top:1.4rem;border-top:1px solid rgba(183,197,184,.25);display:flex;flex-wrap:wrap;gap:.5rem 2rem;justify-content:space-between;font-size:.9rem}
.footer-bottom ul{display:flex;flex-wrap:wrap;gap:0 1.5rem}

/* Floating WhatsApp */
.wa-float{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:calc(max(16px,env(safe-area-inset-bottom)) + var(--banner-h));z-index:40;display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:var(--forest);color:#fff;border:2px solid var(--ivory);box-shadow:0 6px 20px rgba(23,28,27,.28);cursor:pointer;text-decoration:none;transition:transform .25s var(--ease),bottom .25s var(--ease)}
.wa-float:hover{transform:translateY(-2px)}
.wa-float svg{width:28px;height:28px}
@media(max-width:640px){.wa-float{width:52px;height:52px}}
body{padding-bottom:0}

/* Dialogs */
dialog{border:0;padding:0;background:var(--ivory);color:var(--charcoal);max-width:none;max-height:none}
dialog::backdrop{background:rgba(23,28,27,.66);backdrop-filter:blur(2px)}
dialog[open]{animation:dlg .3s var(--ease)}
dialog[open]::backdrop{animation:fade .3s var(--ease)}
@keyframes dlg{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
.dlg-panel{width:min(640px,100vw);height:100vh;height:100dvh;margin:0 0 0 auto;display:flex;flex-direction:column;overflow:hidden}
dialog.side{margin:0 0 0 auto;width:min(640px,100%);height:100%;max-height:100%}
dialog.side[open]{animation:slide .35s var(--ease)}
@keyframes slide{from{transform:translateX(30px);opacity:0}to{transform:none;opacity:1}}
.dlg-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;padding:22px clamp(20px,4vw,40px) 16px;border-bottom:1px solid var(--border)}
.dlg-head h2{font-size:clamp(1.7rem,4vw,2.3rem)}
.dlg-body{padding:20px clamp(20px,4vw,40px) 32px;overflow:auto;flex:1;overscroll-behavior:contain}
.icon-btn{width:48px;height:48px;border:1px solid var(--border);background:transparent;cursor:pointer;display:grid;place-items:center;flex:none;border-radius:2px}
.icon-btn:hover{border-color:var(--charcoal)}
.icon-btn svg{width:20px;height:20px}
.policy h3{font-size:1.3rem;margin:1.6rem 0 .4rem}
.policy p,.policy li{color:var(--muted);margin-bottom:.6rem}
.policy ul{list-style:disc;padding-left:1.3rem}

/* Form */
.form{display:grid;gap:18px}
.field{display:grid;gap:6px}
.field>label,.field>legend,fieldset legend{font-weight:500;font-size:.95rem;padding:0}
.req{color:var(--forest)}
.hint{font-size:.85rem;color:var(--muted)}
.input{width:100%;min-height:48px;padding:.7rem .9rem;border:1px solid #9aa59d;background:var(--white);border-radius:2px;font-size:1rem}
textarea.input{min-height:110px;resize:vertical}
.input:hover{border-color:var(--charcoal)}
.input[aria-invalid=true]{border-color:#a3321f;background:#fff8f6}
.err{color:#9b2c1a;font-size:.88rem;font-weight:500;min-height:0}
fieldset{border:0;padding:0;margin:0;min-width:0}
.radios{display:flex;flex-wrap:wrap;gap:8px 10px;margin-top:6px}
.radios label{display:inline-flex;align-items:center;gap:8px;border:1px solid #9aa59d;background:#fff;padding:0 14px;min-height:46px;cursor:pointer;border-radius:2px;font-size:.97rem}
.radios input{accent-color:var(--forest);width:18px;height:18px}
.radios label:has(input:checked){border-color:var(--forest);background:#eaf0ea}
.radios label:has(input:focus-visible){outline:2px solid var(--forest);outline-offset:2px}
.notice{border-left:3px solid var(--forest);background:#eaf0ea;padding:12px 14px;font-size:.92rem}
.notice.warn{border-color:#a3321f;background:#fbeee9;color:#5c1b10}
.form-status{font-size:.95rem}
.form-actions{display:grid;gap:12px;margin-top:4px}
.form-actions .btn{width:100%}
@media(min-width:560px){.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}}

/* Lightbox */
dialog.lightbox{background:var(--charcoal);color:#fff;width:min(1100px,100vw);max-height:100dvh;margin:auto}
.lb{display:grid;grid-template-rows:1fr auto;max-height:100dvh}
.lb img{max-width:100%;max-height:calc(100dvh - 110px);margin:auto;object-fit:contain}
.lb-bar{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:12px 16px;font-size:.95rem}
.lb-bar .icon-btn{border-color:rgba(255,255,255,.35);color:#fff}
.lb-nav{display:flex;gap:8px}
.lb-close{position:absolute;top:10px;right:10px;border-color:rgba(255,255,255,.4);color:#fff;background:rgba(23,28,27,.6)}

/* Consent */
.consent{position:fixed;left:0;right:0;bottom:0;z-index:60;background:var(--charcoal);color:var(--ivory);border-top:1px solid rgba(183,197,184,.35);padding:16px var(--pad) max(16px,env(safe-area-inset-bottom));max-height:80vh;overflow:auto}
.consent-inner{max-width:var(--max);margin:auto;display:grid;gap:14px 32px}
@media(min-width:900px){.consent-inner{grid-template-columns:1fr auto;align-items:center}}
.consent p{font-size:.93rem;line-height:1.5;max-width:60em}
.consent .link{color:var(--sage)}
.consent-actions{display:flex;flex-wrap:wrap;gap:8px}
.consent .btn{min-height:44px;padding:.55rem 1.1rem;font-size:.95rem}
.consent .btn-ghost{color:var(--ivory)}
.consent .btn-ghost:hover{background:var(--ivory);color:var(--charcoal)}
.consent-prefs{display:grid;gap:12px;grid-column:1/-1}
.pref{display:flex;gap:12px;align-items:flex-start;padding:10px 0;border-top:1px solid rgba(183,197,184,.3)}
.pref input{width:22px;height:22px;margin-top:2px;accent-color:var(--sage);flex:none}
.pref small{display:block;color:var(--sage)}
.pref label{cursor:pointer}

/* Reveal */
.js .reveal{opacity:0;transform:translateY(14px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.js .reveal.in{opacity:1;transform:none}

@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  .js .reveal{opacity:1;transform:none}
}
@media print{.wa-float,.consent,.utility{display:none}}

