    const setErr = (id, msg) => { const f = field(id), e = $('#e-' + id); if (!f || !e) return; e.textContent = msg || ''; if (msg) f.setAttribute('aria-invalid', 'true'); else f.removeAttribute('aria-invalid'); };
    function validate() {
      const v = Object.fromEntries(new FormData(form).entries());
      const err = {};
      if (!v.name || v.name.trim().length < 2) err.name = 'Informe seu nome completo.';
      const pd = digits(v.phone);
      if (!v.phone || !v.phone.trim()) err.phone = 'Informe um telefone ou WhatsApp.';
      else if (pd.length < 8 || pd.length > 15 || /[^\d\s+().-]/.test(v.phone)) err.phone = 'Informe um número válido com DDD ou código do país (8 a 15 dígitos).';
      if (v.email && v.email.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.email.trim())) err.email = 'Informe um e-mail válido ou deixe em branco.';
      if (!v.city || !v.city.trim()) err.city = 'Informe sua cidade ou CEP.';
      if (!v.service) err.service = 'Escolha o serviço desejado.';
      ['name', 'phone', 'email', 'city', 'service'].forEach((k) => setErr(k, err[k]));
      return { v, err };
    }
    ['name', 'phone', 'email', 'city', 'service'].forEach((k) => field(k).addEventListener('input', () => { if (field(k).getAttribute('aria-invalid')) setErr(k, ''); }));
    const wa = waNumber();
    if (!wa) {
      cfg.innerHTML = isDev()
        ? '<div class="notice warn" role="alert"><strong>Configuração necessária (aviso para desenvolvedores):</strong> contact.whatsapp está ausente ou inválido em src/config.js. Não é possível enviar pedidos até definir um número válido.</div>'
        : `<div class="notice warn" role="alert">Os pedidos de orçamento online estão temporariamente indisponíveis. Entre em contato${K.phone ? ` por telefone: <a href="tel:+${digits(K.phone)}">${esc(K.phone)}</a>` : ''}${K.email ? `${K.phone ? ' ou' : ''} por e-mail: <a href="mailto:${esc(K.email)}">${esc(K.email)}</a>` : ''}.</div>`;
      console.warn('[Home Services Elite] contact.whatsapp is missing or invalid; estimate form cannot open WhatsApp.');
    }
    form.addEventListener('submit', (e) => {
      e.preventDefault(); status.textContent = '';
      if (!wa) { status.innerHTML = '<span class="err">O WhatsApp não está configurado, então não foi possível preparar a mensagem.</span>'; return; }
      const { v, err } = validate();
      const keys = Object.keys(err);
      if (keys.length) { status.innerHTML = `<span class="err">Corrija ${keys.length === 1 ? '1 campo' : keys.length + ' campos'} acima.</span>`; field(keys[0]).focus(); return; }
      const lines = [`Olá, ${B.name}! Gostaria de solicitar um orçamento.`, '',
        `Nome: ${v.name.trim()}`, `Telefone/WhatsApp: ${v.phone.trim()}`];
      if (v.email && v.email.trim()) lines.push(`E-mail: ${v.email.trim()}`);
      lines.push(`Cidade/CEP: ${v.city.trim()}`, `Serviço: ${serviceName(v.service)}`, `Contato preferido: ${v.method}`);
      if (v.desc && v.desc.trim()) lines.push('', `Detalhes: ${v.desc.trim()}`);
      const url = `https://wa.me/${wa}?text=${encodeURIComponent(lines.join('\n'))}`;
      const w = window.open(url, '_blank', 'noopener');
      status.innerHTML = `Sua mensagem está pronta no WhatsApp. <strong>Ela ainda não foi enviada:</strong> revise e toque em enviar por lá. ${w ? '' : ''}<a href="${esc(url)}" target="_blank" rel="noopener noreferrer">Abrir o WhatsApp novamente<span class="sr-only"> (abre em nova aba)</span></a>`;
    });
    window.__openEstimate = (serviceId, trigger) => {
      if (serviceId && services.some((s) => s.id === serviceId)) field('service').value = serviceId;
      status.textContent = '';
      openDlg(dlg, trigger);
    };
    window.__buildWhatsAppMessage = null; // (kept private; message is built on submit)
  }

  /* ---------- lightbox ---------- */
  function setupLightbox() {
    const d = $('#lb-dlg'); if (!d) return;
    wireDialog(d);
    const items = C.gallery.items; let idx = 0;
    const show = (i) => { idx = (i + items.length) % items.length; const g = items[idx]; const im = $('#lb-img'); im.src = g.src; im.alt = g.alt || ''; $('#lb-cap').textContent = (g.caption || '') + (items.length > 1 ? `  (${idx + 1}/${items.length})` : ''); };
    $$('[data-lb]').forEach((b) => b.addEventListener('click', () => { show(+b.dataset.lb); openDlg(d, b); }));
    $('#lb-prev').addEventListener('click', () => show(idx - 1));
    $('#lb-next').addEventListener('click', () => show(idx + 1));
    d.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(idx - 1); if (e.key === 'ArrowRight') show(idx + 1); });
    if (items.length < 2) { $('#lb-prev').hidden = true; $('#lb-next').hidden = true; }
  }

  /* ---------- nav, accordion, reveal ---------- */
  function setupNav() {
    const btn = $('.menu-btn'), nav = $('#site-nav'); if (!btn) return;
    const set = (open) => { btn.setAttribute('aria-expanded', String(open)); nav.classList.toggle('open', open); };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => { if (e.target.closest('a,button')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); } });
    window.matchMedia('(min-width:960px)').addEventListener('change', () => set(false));
    // Hidden mobile nav must not be focusable
    const sync = () => { const mobile = !window.matchMedia('(min-width:960px)').matches; nav.inert = mobile && !nav.classList.contains('open'); };
    new MutationObserver(sync).observe(nav, { attributes: true, attributeFilter: ['class'] });
    window.matchMedia('(min-width:960px)').addEventListener('change', sync); sync();
  }
  function setupAccordion() {
    $$('.acc-btn').forEach((b) => b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') === 'true', p = $('#' + b.getAttribute('aria-controls'));
      b.setAttribute('aria-expanded', String(!open)); p.classList.toggle('open', !open); p.inert = open;
    }));
  }
  function setupReveal() {
    const els = $$('.reveal');
    if (reduced() || !('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('in')); return; }
    const io = new IntersectionObserver((en) => en.forEach((x) => { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
    els.forEach((e) => io.observe(e));
  }

  /* ---------- consent & optional scripts ---------- */
  const CKEY = 'hse_consent_v1';
  let memConsent = null; const loaded = {};
  const readConsent = () => { try { const r = localStorage.getItem(CKEY); return r ? JSON.parse(r) : memConsent; } catch (e) { return memConsent; } };
  const writeConsent = (c) => { memConsent = c; try { localStorage.setItem(CKEY, JSON.stringify(c)); } catch (e) { console.warn('[Home Services Elite] Could not store consent; it will apply to this visit only.'); } };
  const addScript = (src) => { const s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); };
  const idOk = (id, re) => re.test(String(id || ''));
  function loadOptional(c) {
    const I = C.integrations || {};
    const ga = I.analytics && I.analytics.ga4MeasurementId, ad = I.advertising || {};
    window.dataLayer = window.dataLayer || [];
    const gtag = function () { window.dataLayer.push(arguments); };
    if (c.analytics && idOk(ga, /^G-[A-Z0-9]+$/) && !loaded.ga) {
      loaded.ga = 1; addScript('https://www.googletagmanager.com/gtag/js?id=' + ga); gtag('js', new Date()); gtag('config', ga);
    }
    if (c.advertising) {
      if (idOk(ad.googleAdsId, /^AW-[0-9]+$/) && !loaded.ads) { loaded.ads = 1; if (!loaded.ga) { addScript('https://www.googletagmanager.com/gtag/js?id=' + ad.googleAdsId); gtag('js', new Date()); } gtag('config', ad.googleAdsId); }
      if (idOk(ad.metaPixelId, /^[0-9]{6,20}$/) && !loaded.meta) {
        loaded.meta = 1;
        /* eslint-disable */
        !function (f, b, e, v, n, t, s) { if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); }; if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = []; t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s); }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        /* eslint-enable */
        window.fbq('init', ad.metaPixelId); window.fbq('track', 'PageView');
      }
    }
  }
  function setupConsent() {
    const bar = $('#consent'), I = C.integrations || {};
    const gaOn = idOk(I.analytics && I.analytics.ga4MeasurementId, /^G-[A-Z0-9]+$/);
    const adOn = idOk(I.advertising && I.advertising.googleAdsId, /^AW-[0-9]+$/) || idOk(I.advertising && I.advertising.metaPixelId, /^[0-9]{6,20}$/);
    $('#c-an-n').textContent = gaOn ? 'Mede como o site é usado.' : 'Não configurado neste site; nada é carregado.';
    $('#c-ad-n').textContent = adOn ? 'Mede campanhas e anúncios.' : 'Não configurado neste site; nada é carregado.';
    const prefs = $('#consent-prefs'), custom = $('#consent-custom');
    const setBar = (show) => {
      bar.hidden = !show;
      document.documentElement.style.setProperty('--banner-h', show ? bar.offsetHeight + 'px' : '0px');
    };
    const apply = (c, reloadNote) => {
      const prev = readConsent();
      writeConsent({ analytics: !!c.analytics, advertising: !!c.advertising, ts: Date.now() });
      loadOptional(readConsent());
      if (prev && ((prev.analytics && !c.analytics) || (prev.advertising && !c.advertising)) && (loaded.ga || loaded.meta || loaded.ads)) {
        const ga = I.analytics && I.analytics.ga4MeasurementId; if (ga) window['ga-disable-' + ga] = true;
      }
      setBar(false);
    };
    const open = () => { const c = readConsent() || {}; $('#c-an').checked = !!c.analytics; $('#c-ad').checked = !!c.advertising; setBar(true); };
    $$('[data-consent]').forEach((b) => b.addEventListener('click', () => { const all = b.dataset.consent === 'all'; apply({ analytics: all, advertising: all }); }));
    custom.addEventListener('click', () => { const x = prefs.hidden; prefs.hidden = !x; custom.setAttribute('aria-expanded', String(x)); setBar(true); if (x) $('#c-an').focus(); });
    $('#consent-save').addEventListener('click', () => apply({ analytics: $('#c-an').checked, advertising: $('#c-ad').checked }));
    window.addEventListener('resize', () => { if (!bar.hidden) setBar(true); });
    window.__openConsent = () => { prefs.hidden = false; custom.setAttribute('aria-expanded', 'true'); open(); $('#c-an').focus(); };
    const existing = readConsent();
    if (existing) loadOptional(existing); else setBar(true);
  }

  /* ---------- boot ---------- */
  function boot() {
    applyTheme(); applyMeta();
    $('#app').innerHTML = utility() + header() + `<main id="main" tabindex="-1">${[hero(), servicesSection(), statement(), approach(), midCta(), featured(), gallery(), why(), about(), areas(), testimonials(), faq(), contact()].join('')}</main>` +
      footer() + floatWa() + estimateDialog() + privacyDialog() + lightboxDialog() + consentBanner();
    setupNav(); setupAccordion(); setupEstimate(); setupLightbox(); setupConsent(); setupReveal();
    wireDialog($('#privacy-dlg'));
    document.addEventListener('click', (e) => {
      const est = e.target.closest('[data-estimate]');
      if (est) { e.preventDefault(); window.__openEstimate(est.dataset.service, est); return; }
      const pv = e.target.closest('[data-privacy]');
      if (pv) { e.preventDefault(); openDlg($('#privacy-dlg'), pv); return; }
      if (e.target.closest('[data-cookie-prefs]')) { e.preventDefault(); window.__openConsent(); }
    });
    if (isDev() && C.isSample) console.info('[Home Services Elite] Template contains SAMPLE content. See README.md and src/config.js.');
  }
  boot();
})();

</script>
